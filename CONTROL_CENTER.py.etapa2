modulos = [
    ("PAYMENT_ENGINE.py", r"C:\IOTEC\PAYMENT_ENGINE.py"),
    ("paypal_server.py", r"C:\IOTEC\paypal_server.py"),
    ("CORE_PHILOSOPHY.py", r"C:\IOTEC\CORE_PHILOSOPHY.py"),
    ("CONFIRM_PAYMENT.py", r"C:\IOTEC\CONFIRM_PAYMENT.py"),
