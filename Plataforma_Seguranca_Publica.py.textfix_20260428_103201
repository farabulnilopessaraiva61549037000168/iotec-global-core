    def gerar_ocorrencia(self):
        bairros = {
            "Centro": (-5.146, -38.100),
            "Zona Norte": (-5.130, -38.110),
            "Lagoa": (-5.155, -38.120),
            "Alto": (-5.140, -38.090)
        }

        tipos = ["Roubo", "Furto", "Suspeita"]

        bairro = random.choice(list(bairros.keys()))

        ocorrencia = {
            "bairro": bairro,
            "tipo": random.choice(tipos),
            "coords": bairros[bairro],
            "hora": time.strftime("%H:%M:%S")
        }

        self.dados.append(ocorrencia)
        return ocorrencia

    def atualizar_mapa(self):
        mapa = folium.Map(location=[-5.145, -38.105], zoom_start=13)

        for d in self.dados[-20:]:
            cor = "red" if d["tipo"] == "Roubo" else "blue"
            folium.CircleMarker(
                location=d["coords"],
                radius=6,
                color=cor,
                fill=True,
                popup=f"{d['tipo']} - {d['bairro']}"
            ).add_to(mapa)

        if not os.path.exists(DIRETORIO):
            os.makedirs(DIRETORIO)

        mapa.save(MAP_FILE)
        self.mapa_view.load(QUrl.fromLocalFile(MAP_FILE))

    def calcular_risco(self):
        contagem = Counter([d["bairro"] for d in self.dados])
        resultado = []

        for bairro, qtd in contagem.items():
            if qtd >= 6:
                nivel = "ALTO"
            elif qtd >= 3:
