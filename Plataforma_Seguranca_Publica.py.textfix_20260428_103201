        conteudo.setStyleSheet("background-color: #0a192f; color: #ccd6f6;")

        layout.addWidget(titulo)
        layout.addWidget(conteudo)
        frame.setLayout(layout)

        frame.texto = conteudo
        return frame

    def simular_dados(self):
        self.timer = QTimer()
