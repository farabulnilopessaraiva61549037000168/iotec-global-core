import requests
import time

HEADERS = {
    "User-Agent": "IOTEC Source Engine"
}


class SourceEngine:

    # --------------------------------------------------

    @staticmethod
    def limpar_nome(nome):

        remover = [

            ", Brasil",

            ", Ceará",

            ", Fortaleza",

            ", Região Nordeste",

            ", Centro",

            ", Pici",

            ", Paupina"

        ]

        for item in remover:

            nome = nome.replace(item, "")

        return nome.split(",")[0].strip()

    # --------------------------------------------------

    @staticmethod
    def openstreetmap(company):

        nome = SourceEngine.limpar_nome(company)

        url = "https://nominatim.openstreetmap.org/search"

        params = {

            "q": nome,

            "format": "jsonv2",

            "limit": 1,

            "addressdetails": 1

        }

        try:

            r = requests.get(

                url,

                params=params,

                headers=HEADERS,

                timeout=20

            )

            if r.status_code != 200:

                return None

            dados = r.json()

            if not dados:

                return None

            d = dados[0]

            return {

                "source":"OpenStreetMap",

                "company_name":company,

                "display_name":d.get("display_name",""),

                "latitude":d.get("lat",""),

                "longitude":d.get("lon",""),

                "osm_class":d.get("class",""),

                "osm_type":d.get("type","")

            }

        except:

            return None

    # --------------------------------------------------

    @staticmethod
    def search(company):

        resultado = {}

        osm = SourceEngine.openstreetmap(company)

        if osm:

            resultado.update(osm)

        return resultado


# =======================================================

if __name__ == "__main__":

    empresa = "Makro Engenharia"

    print("="*70)
    print("SOURCE ENGINE")
    print("="*70)
    print()

    dados = SourceEngine.search(empresa)

    for k,v in dados.items():

        print(f"{k:18}",v)