from datetime import datetime
import time
import random
import time
def modo_rotacao():
    print("\n🎬 Modo rotação ativado\n")

    while True:
        interfaces = listar_interfaces()

        if not interfaces:
            print("⚠️ Nenhuma interface disponível")
