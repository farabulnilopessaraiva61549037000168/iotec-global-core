acoes = []

try:

    if pendentes > 0:
        acoes.append(f"Existem {pendentes} pagamentos aguardando confirmação.")

    if oportunidades < 100:
        acoes.append("Pipeline pequeno. Recomenda-se intensificar a prospecção.")

    if receita < META * 0.30:
        acoes.append("Receita abaixo de 30% da meta mensal.")

    if falta > 0:
        acoes.append(f"Faltam R$ {falta:,.2f} para atingir a meta.")

except:
    pass

integracoes = [
