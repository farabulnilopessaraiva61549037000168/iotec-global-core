<service>
	<id>iotec_wppconnect.exe</id>
	<name>IOTEC_WPPConnect</name>
	<description>Servico local de disparos de mensagens e boletos da IOTEC via WPPConnect</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>C:\IOTEC\wppconnect-server\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\IOTEC\wppconnect-server\index.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>IOTEC_WPPConnect wrapper</argument>
	<argument>--grow</argument>
	<argument>0.25</argument>
	<argument>--wait</argument>
	<argument>1</argument>
	<argument>--maxrestarts</argument>
	<argument>3</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<serviceaccount>
		<domain>DESKTOP-8K2AK4E</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\IOTEC\wppconnect-server</workingdirectory>
</service>